# Copy to .env in the repository root and replace the placeholders.
# Process environment variables take precedence over this file.
# URL-encode special characters in the username/password (e.g. @ becomes %40).
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/triptogether

# Generate a random secret with at least 32 bytes; never use this placeholder.
JWT_SECRET_KEY=replace-with-a-secure-random-secret
# Only HS256 is supported. Default access-token lifetime: 30 minutes.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# development keeps /health usable without DB/JWT; production validates both at startup.
# Production still requires a separate migration step and HTTPS deployment.
APP_ENV=development
# JSON array of exact browser origins, no trailing slash. Default [] disables cross-origin access.
# Example development value: ["http://127.0.0.1:5173","http://localhost:5173"]
# Production origins must use HTTPS. Native mobile HTTP is not governed by browser CORS.
CORS_ORIGINS=[]

# Docker Compose simulation only. Use a unique, URL-safe value; never commit .env.
POSTGRES_PASSWORD=replace-with-a-url-safe-postgres-password
# Docker Compose forwards this public build-time URL to the frontend image.
VITE_API_BASE_URL=http://127.0.0.1:8000
