VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional map tiles. Leave both unset for the public OpenStreetMap tiles, which
# suit development and light demos only; use a commercial or self-hosted tile
# service before real traffic. A custom URL (HTTPS, with {z}/{x}/{y}) REQUIRES
# its provider's credit in VITE_MAP_TILE_ATTRIBUTION, as plain text (HTML is
# escaped). Without it the app falls back to OSM tiles and logs one warning.
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© Example Maps © OpenStreetMap contributors
